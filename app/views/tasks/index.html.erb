<div class="min-h-screen bg-pink-50/60 py-8 px-4 sm:px-6 lg:px-8 font-sans">
  <div class="max-w-4xl mx-auto space-y-6">

    <!-- Top Header Banner -->
    <div class="bg-gradient-to-r from-pink-400 via-pink-300 to-rose-300 rounded-3xl p-6 shadow-sm text-white flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">🌸 Draftbook</h1>
        <p class="text-pink-100 text-sm mt-1">Manage your day with soft pink aesthetic details.</p>
      </div>
      <%= link_to "← Dashboard", root_path, class: "bg-white/20 hover:bg-white/30 text-white text-xs font-semibold px-4 py-2 rounded-xl backdrop-blur-sm transition" %>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white p-4 rounded-2xl border border-pink-100 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-pink-400 uppercase tracking-wider">Total Tasks</p>
          <p class="text-2xl font-bold text-gray-800 mt-0.5"><%= @tasks.count %></p>
        </div>
        <div class="w-10 h-10 bg-pink-100/70 rounded-2xl flex items-center justify-center text-pink-500 font-bold">📋</div>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-pink-100 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-pink-400 uppercase tracking-wider">Completed</p>
          <p class="text-2xl font-bold text-gray-800 mt-0.5"><%= @tasks.where(completed: true).count %></p>
        </div>
        <div class="w-10 h-10 bg-pink-100/70 rounded-2xl flex items-center justify-center text-pink-500 font-bold">✨</div>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-pink-100 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-pink-400 uppercase tracking-wider">Pending</p>
          <p class="text-2xl font-bold text-gray-800 mt-0.5"><%= @tasks.where(completed: false).count %></p>
        </div>
        <div class="w-10 h-10 bg-pink-100/70 rounded-2xl flex items-center justify-center text-pink-500 font-bold">⏳</div>
      </div>
    </div>

    <!-- Add New Task Form -->
    <div class="bg-white rounded-2xl border border-pink-100 shadow-sm p-6">
      <h2 class="text-base font-bold text-pink-600 mb-4 flex items-center gap-2">
        <span>💖</span> Create New Task
      </h2>

      <%= form_with(model: Task.new, url: tasks_path, local: true, class: "space-y-4") do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :title, "Task Title", class: "block text-xs font-semibold text-gray-600 mb-1" %>
            <%= f.text_field :title, placeholder: "e.g., Design pink badges", required: true, class: "w-full border border-pink-200 rounded-xl focus:ring-2 focus:ring-pink-300 focus:border-pink-400 text-sm px-3.5 py-2.5 bg-pink-50/20 text-gray-800" %>
          </div>
          <div>
            <%= f.label :description, "Description (Optional)", class: "block text-xs font-semibold text-gray-600 mb-1" %>
            <%= f.text_field :description, placeholder: "Add quick details...", class: "w-full border border-pink-200 rounded-xl focus:ring-2 focus:ring-pink-300 focus:border-pink-400 text-sm px-3.5 py-2.5 bg-pink-50/20 text-gray-800" %>
          </div>
        </div>

        <div class="flex justify-end">
          <%= f.submit "Add Task", class: "bg-pink-400 hover:bg-pink-500 text-white font-semibold text-sm px-5 py-2.5 rounded-xl shadow-sm transition cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <!-- Task List -->
    <div class="bg-white rounded-2xl border border-pink-100 shadow-sm p-6">
      <h2 class="text-base font-bold text-gray-800 mb-4 flex items-center gap-2">
        <span>📌</span> Your Task List
      </h2>

      <% if @tasks.empty? %>
        <div class="text-center py-10 text-pink-300">
          <p class="text-4xl mb-2">🌸</p>
          <p class="text-sm font-medium">No tasks yet! Create one above to fill your list.</p>
        </div>
      <% else %>
        <div class="space-y-3">
          <% @tasks.each do |task| %>
            <div class="flex items-center justify-between p-4 rounded-xl border border-pink-100/80 <%= task.completed ? 'bg-pink-50/30 opacity-70' : 'bg-white hover:border-pink-200' %> transition shadow-2xs">
              <div class="flex items-center space-x-3">
                <!-- Interactive Heart Toggle Button -->
                <%= button_to toggle_task_path(task), method: :patch, class: "text-lg hover:scale-125 transition-transform cursor-pointer focus:outline-none" do %>
                  <%= task.completed ? "💗" : "🤍" %>
                <% end %>

                <div>
                  <h3 class="font-semibold text-gray-800 text-sm <%= 'line-through text-gray-400' if task.completed %>">
                    <%= task.title %>
                  </h3>
                  <% if task.description.present? %>
                    <p class="text-xs text-gray-500 mt-0.5"><%= task.description %></p>
                  <% end %>
                </div>
              </div>

              <div class="flex items-center space-x-3">
                <span class="text-xs px-2.5 py-1 rounded-full font-medium <%= task.completed ? 'bg-pink-100 text-pink-600' : 'bg-rose-50 text-rose-500 border border-rose-100' %>">
                  <%= task.completed ? "Completed" : "In Progress" %>
                </span>
                <%= button_to task_path(task), method: :delete, class: "text-pink-300 hover:text-rose-500 text-xs transition p-1" do %>
                  🗑️
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
</div>