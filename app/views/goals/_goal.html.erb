<div id="<%= dom_id goal %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= goal.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= goal.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Category:</strong>
    <%= goal.category %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Deadline:</strong>
    <%= goal.deadline %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Progress:</strong>
    <%= goal.progress %>
  </div>
</div>
