<div class="min-h-screen bg-rose-50/40 p-6 sm:p-10">
  <div class="max-w-6xl mx-auto space-y-6">
    
    <!-- Admin Header -->
    <div class="flex items-center justify-between bg-white/90 backdrop-blur-md p-6 rounded-3xl border border-pink-100 shadow-xl shadow-pink-100/50">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-800 tracking-tight flex items-center gap-2">
          <span>👑</span> Admin Dashboard
        </h1>
        <p class="text-xs font-semibold text-pink-400 mt-1 uppercase tracking-wider">Manage registered app users</p>
      </div>
      <div>
        <%= link_to "← Back to Main App", root_path, class: "px-4 py-2.5 rounded-2xl bg-pink-50 hover:bg-pink-100 text-pink-600 font-bold text-xs transition-all" %>
      </div>
    </div>

    <!-- Users Table Card -->
    <div class="bg-white/90 backdrop-blur-md rounded-3xl p-6 border border-pink-100 shadow-xl shadow-pink-100/50 overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-pink-100 text-xs font-bold text-pink-400 uppercase tracking-wider">
            <th class="py-4 px-4">ID</th>
            <th class="py-4 px-4">Email Address</th>
            <th class="py-4 px-4">Role</th>
            <th class="py-4 px-4">Joined On</th>
            <th class="py-4 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-pink-50 text-sm">
          <% @users.each do |user| %>
            <tr class="hover:bg-rose-50/30 transition-colors">
              <td class="py-4 px-4 font-mono text-xs text-slate-400">#<%= user.id %></td>
              <td class="py-4 px-4 font-bold text-slate-800"><%= user.email_address %></td>
              <td class="py-4 px-4">
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold <%= user.admin? ? 'bg-purple-100 text-purple-600' : 'bg-pink-100 text-pink-600' %>">
                  <%= user.admin? ? '👑 Admin' : '👤 User' %>
                </span>
              </td>
              <td class="py-4 px-4 text-xs font-medium text-slate-500">
                <%= user.created_at.strftime("%b %d, %Y") %>
              </td>
              <td class="py-4 px-4 text-right">
                <% unless user == Current.user %>
                  <%= button_to admin_user_path(user), method: :delete, class: "px-3 py-1.5 rounded-xl bg-red-50 hover:bg-red-100 text-red-600 font-bold text-xs transition-all cursor-pointer", data: { confirm: "Are you sure you want to delete this user?" } do %>
                    Delete
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>