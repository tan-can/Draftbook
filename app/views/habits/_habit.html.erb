<div id="<%= dom_id habit %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= habit.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Streak:</strong>
    <%= habit.streak %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Best streak:</strong>
    <%= habit.best_streak %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Last done on:</strong>
    <%= habit.last_done_on %>
  </div>
</div>
