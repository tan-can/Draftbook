<%= form_with(model: habit, class: "contents") do |form| %>
  <% if habit.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(habit.errors.count, "error") %> prohibited this habit from being saved:</h2>

      <ul class="list-disc ml-6">
        <% habit.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": habit.errors[:name].none?, "border-red-400 focus:outline-red-600": habit.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :streak %>
    <%= form.number_field :streak, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": habit.errors[:streak].none?, "border-red-400 focus:outline-red-600": habit.errors[:streak].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :best_streak %>
    <%= form.number_field :best_streak, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": habit.errors[:best_streak].none?, "border-red-400 focus:outline-red-600": habit.errors[:best_streak].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :last_done_on %>
    <%= form.date_field :last_done_on, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": habit.errors[:last_done_on].none?, "border-red-400 focus:outline-red-600": habit.errors[:last_done_on].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
