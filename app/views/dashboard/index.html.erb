<div class="min-h-screen bg-rose-50/40 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto space-y-8">
    
    <!-- Top Bar / Pink Gradient Hero Header -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-pink-500 via-rose-500 to-fuchsia-500 p-8 sm:p-10 text-white shadow-xl shadow-pink-200/60">
      <!-- Decorative Background Blur Glows -->
      <div class="absolute -right-12 -top-12 w-64 h-64 bg-white/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute right-1/4 -bottom-12 w-48 h-48 bg-fuchsia-400/30 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-xs font-semibold text-white border border-white/30 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
            Whimsy ✨ Dashboard
          </div>
          <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white drop-shadow-sm">
            Welcome back! ✨
          </h1>
          <p class="text-pink-100 text-sm sm:text-base font-medium opacity-95">
            Logged in as <span class="bg-white/20 px-2.5 py-0.5 rounded-lg text-white font-semibold backdrop-blur-sm"><%= Current.user&.email_address %></span>
          </p>
        </div>

        <div class="flex items-center gap-3">
          <%= button_to session_path, method: :delete, class: "inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-white/20 hover:bg-white/30 backdrop-blur-md text-white font-semibold text-sm transition-all border border-white/30 shadow-sm hover:scale-105 active:scale-95 cursor-pointer" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            Sign Out
          <% end %>
        </div>
      </div>
    </div>

    <!-- Quick Stats Summary Row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      
      <!-- Stat 1: Tasks -->
      <div class="bg-white/80 backdrop-blur-sm p-6 rounded-3xl border border-pink-100 shadow-sm hover:shadow-md hover:border-pink-200 transition-all flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-pink-400 uppercase tracking-wider">Total Tasks</p>
          <h3 class="text-3xl font-black text-slate-800 mt-1"><%= @tasks&.count || 0 %></h3>
        </div>
        <div class="w-14 h-14 rounded-2xl bg-pink-100/70 text-pink-500 flex items-center justify-center text-2xl shadow-inner">
          📋
        </div>
      </div>

      <!-- Stat 2: Goals -->
      <div class="bg-white/80 backdrop-blur-sm p-6 rounded-3xl border border-rose-100 shadow-sm hover:shadow-md hover:border-rose-200 transition-all flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-rose-400 uppercase tracking-wider">Active Goals</p>
          <h3 class="text-3xl font-black text-slate-800 mt-1"><%= @goals&.count || 0 %></h3>
        </div>
        <div class="w-14 h-14 rounded-2xl bg-rose-100/70 text-rose-500 flex items-center justify-center text-2xl shadow-inner">
          🎯
        </div>
      </div>

      <!-- Stat 3: Habits -->
      <div class="bg-white/80 backdrop-blur-sm p-6 rounded-3xl border border-fuchsia-100 shadow-sm hover:shadow-md hover:border-fuchsia-200 transition-all flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-fuchsia-400 uppercase tracking-wider">Habit Streaks</p>
          <h3 class="text-3xl font-black text-slate-800 mt-1"><%= @habits&.count || 0 %></h3>
        </div>
        <div class="w-14 h-14 rounded-2xl bg-fuchsia-100/70 text-fuchsia-500 flex items-center justify-center text-2xl shadow-inner">
          ⚡
        </div>
      </div>

    </div>

    <!-- Main Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Tasks Card -->
      <div class="bg-white/90 backdrop-blur-sm rounded-3xl p-7 border border-pink-100 shadow-sm hover:shadow-xl hover:shadow-pink-100/60 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-3">
              <span class="w-12 h-12 rounded-2xl bg-pink-100/80 text-pink-500 flex items-center justify-center text-xl shadow-sm">
                📝
              </span>
              <div>
                <h2 class="text-xl font-extrabold text-slate-800 group-hover:text-pink-600 transition-colors">Tasks</h2>
                <p class="text-xs font-medium text-pink-400">Action items & To-dos</p>
              </div>
            </div>
            <%= link_to new_task_path, class: "p-2.5 rounded-xl text-pink-400 hover:text-pink-600 hover:bg-pink-50 transition-colors" do %>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
            <% end %>
          </div>

          <p class="text-slate-500 text-sm mb-6 leading-relaxed">
            Organize daily priorities, set deadlines, and check off completed work.
          </p>

          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-pink-50 text-pink-600 text-xs font-semibold mb-6">
            <span>✨ <%= @tasks&.count || 0 %> Pending Tasks</span>
          </div>
        </div>

        <div class="pt-5 border-t border-pink-100">
          <%= link_to tasks_path, class: "flex items-center justify-center gap-2 w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white font-bold text-sm shadow-md shadow-pink-200 transition-all hover:scale-[1.02] active:scale-[0.98]" do %>
            <span>View All Tasks</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          <% end %>
        </div>
      </div>

      <!-- Goals Card -->
      <div class="bg-white/90 backdrop-blur-sm rounded-3xl p-7 border border-rose-100 shadow-sm hover:shadow-xl hover:shadow-rose-100/60 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-3">
              <span class="w-12 h-12 rounded-2xl bg-rose-100/80 text-rose-500 flex items-center justify-center text-xl shadow-sm">
                🎯
              </span>
              <div>
                <h2 class="text-xl font-extrabold text-slate-800 group-hover:text-rose-600 transition-colors">Goals</h2>
                <p class="text-xs font-medium text-rose-400">Milestones & Vision</p>
              </div>
            </div>
            <%= link_to new_goal_path, class: "p-2.5 rounded-xl text-rose-400 hover:text-rose-600 hover:bg-rose-50 transition-colors" do %>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
            <% end %>
          </div>

          <p class="text-slate-500 text-sm mb-6 leading-relaxed">
            Break down big ambitions into clear, achievable milestones and track long-term progress.
          </p>

          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-rose-50 text-rose-600 text-xs font-semibold mb-6">
            <span>🚀 <%= @goals&.count || 0 %> Active Goals</span>
          </div>
        </div>

        <div class="pt-5 border-t border-rose-100">
          <%= link_to goals_path, class: "flex items-center justify-center gap-2 w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-rose-500 to-pink-500 hover:from-rose-600 hover:to-pink-600 text-white font-bold text-sm shadow-md shadow-rose-200 transition-all hover:scale-[1.02] active:scale-[0.98]" do %>
            <span>Track Goals</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          <% end %>
        </div>
      </div>

      <!-- Habits Card -->
      <div class="bg-white/90 backdrop-blur-sm rounded-3xl p-7 border border-fuchsia-100 shadow-sm hover:shadow-xl hover:shadow-fuchsia-100/60 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-3">
              <span class="w-12 h-12 rounded-2xl bg-fuchsia-100/80 text-fuchsia-500 flex items-center justify-center text-xl shadow-sm">
                ⚡
              </span>
              <div>
                <h2 class="text-xl font-extrabold text-slate-800 group-hover:text-fuchsia-600 transition-colors">Habits</h2>
                <p class="text-xs font-medium text-fuchsia-400">Routines & Streaks</p>
              </div>
            </div>
            <%= link_to new_habit_path, class: "p-2.5 rounded-xl text-fuchsia-400 hover:text-fuchsia-600 hover:bg-fuchsia-50 transition-colors" do %>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
            <% end %>
          </div>

          <p class="text-slate-500 text-sm mb-6 leading-relaxed">
            Build consistency with daily routine tracking, visual streaks, and habit formation.
          </p>

          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-fuchsia-50 text-fuchsia-600 text-xs font-semibold mb-6">
            <span>🔥 <%= @habits&.count || 0 %> Habits Active</span>
          </div>
        </div>

        <div class="pt-5 border-t border-fuchsia-100">
          <%= link_to habits_path, class: "flex items-center justify-center gap-2 w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-fuchsia-500 to-pink-500 hover:from-fuchsia-600 hover:to-pink-600 text-white font-bold text-sm shadow-md shadow-fuchsia-200 transition-all hover:scale-[1.02] active:scale-[0.98]" do %>
            <span>Build Habits</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          <% end %>
        </div>
      </div>

    </div>

  </div>
</div>